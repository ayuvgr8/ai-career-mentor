# Copy to .env locally. Never commit real credentials. Use deployment Secrets on Replit.
NODE_ENV=development
PORT=5050
APP_ORIGIN=http://localhost:5050
DATABASE_URL=postgres://localhost:5432/rolevo

# replit is the default. anonymous is an explicit, device-only fallback, not a login account.
AUTH_MODE=replit
REPL_ID=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
CAREER_AI_MODEL=gpt-5.6-terra

# Base URL includes /api/v1. HTTPS only. Do not use an AI auto-approval workflow.
AGENTICORG_URL=
AGENTICORG_KEY=
AGENTICORG_WORKFLOW_ID=
AGENTICORG_COMPANY_ID=
AGENTICORG_REVIEWER_NAME=
AGENTICORG_REVIEWER_ID=
# Only set after an actual human approve AND reject have passed the live checklist.
AGENTICORG_VERIFIED=false

# Optional tuning. Production trusts one proxy hop by default (Render/Vercel).
# DATABASE_POOL_MAX=10
# TRUST_PROXY=1
