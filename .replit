modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "Rolevo"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "APP_ORIGIN=http://localhost:5173 PORT=5050 pnpm --filter @workspace/api-server run dev"
waitForPort = 5050

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5173 BASE_PATH=/ API_PROXY_TARGET=http://127.0.0.1:5050 pnpm --filter @workspace/career-mentor run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
