# Copy to .env locally. Never commit real credentials. Use deployment Secrets on Replit.
NODE_ENV=development
PORT=5050
APP_ORIGIN=http://localhost:5050
DATABASE_URL=postgres://localhost:5432/rolevo

# replit is the default. anonymous is an explicit, device-only fallback, not a login account.
AUTH_MODE=replit
REPL_ID=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
CAREER_AI_MODEL=gpt-5.6-terra

# Base URL includes /api/v1. HTTPS only. Do not use an AI auto-approval workflow.
AGENTICORG_URL=
AGENTICORG_KEY=
AGENTICORG_WORKFLOW_ID=
AGENTICORG_COMPANY_ID=
AGENTICORG_REVIEWER_NAME=
AGENTICORG_REVIEWER_ID=
# Only set after an actual human approve AND reject have passed the live checklist.
AGENTICORG_VERIFIED=false

# Voice mentor (ElevenLabs Conversational AI). Server-only; never exposed to the browser.
# Without both, GET /api/voice/session answers 503 and nothing is spent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shows the voice nav link / role-chat button. Set true only after one real voice call works.
VOICE_VERIFIED=false

# Custom-LLM bridge for the ElevenLabs agent: POST /api/agentic-llm/chat/completions.
# Reuses AGENTICORG_URL + AGENTICORG_KEY above. ADAPTER_SHARED_TOKEN is a random secret
# (e.g. `openssl rand -hex 32`) pasted into the ElevenLabs Custom LLM "API key" field.
# Route answers 503 until all of these are set.
AGENTICORG_AGENT_UUID=
ADAPTER_SHARED_TOKEN=
